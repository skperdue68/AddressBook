{
  "name": "hearthbound-discord-bot",
  "version": "1.0.70",
  "private": true,
  "type": "module",
  "description": "HearthBound: a menu-driven Discord bot for ESO house discovery, private/public/global directories, comments, and guided housing tours.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy:commands": "node src/deploy-commands.js",
    "db:init": "node src/db/init.js",
    "db:seed": "node src/db/seed-houses.js",
    "test": "node --test --test-concurrency=4 \"test/*.test.js\"",
    "db:migrate-sqlite-to-mariadb": "node src/db/migrate-sqlite-to-mariadb.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "discord.js": "^14.22.1",
    "dotenv": "^17.2.2",
    "mariadb": "^3.4.5",
    "sharp": "^0.35.5"
  }
}
