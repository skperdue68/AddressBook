DISCORD_TOKEN=replace_with_bot_token
DISCORD_CLIENT_ID=replace_with_application_id
# Development guild. Guild deployment targets this server. Global deployment also clears old guild-scoped commands here first.
DISCORD_GUILD_ID=
# Optional comma-separated additional guild IDs whose legacy guild-scoped commands should be cleared during a global deployment.
DISCORD_CLEANUP_GUILD_IDS=

# Database backend. SQLite is the default if DB_TYPE is omitted.
# Use "sqlite" for the built-in local database or "mariadb" for MariaDB.
DB_TYPE=sqlite

# SQLite settings (used when DB_TYPE=sqlite, and also the default when DB_TYPE is omitted).
DATABASE_PATH=./data/eso-housing.sqlite

# MariaDB settings (used only when DB_TYPE=mariadb).
# HearthBound creates this database when it is missing, then creates/migrates its schema.
# DB_USER therefore needs CREATE DATABASE, or an administrator must create DB_NAME once.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=addressbook
DB_USER=addressbook
DB_PASSWORD=replace_with_database_password
# Optional: if set, the password is read from this file and DB_PASSWORD is ignored.
# Useful for Docker/Podman secrets.
DB_PASSWORD_FILE=
DB_CONNECTION_LIMIT=5

# Optional one-time database transfer. The source is validated first, then the destination is ERASED.
# DB_TYPE=mariadb copies SQLite -> MariaDB; DB_TYPE=sqlite copies MariaDB -> SQLite.
# Persistent data and ESO environments are verified after copying. Active tour sessions and
# Share Pass session links are intentionally not copied. After success, set MIGRATE=false and restart.
MIGRATE=false
MIGRATE_CONFIRM=
# SQLite source or destination used by the transfer. Defaults to DATABASE_PATH.
SQLITE_MIGRATION_PATH=./data/eso-housing.sqlite
# Optional completion-marker location. Defaults to DATABASE_PATH + .migration-complete.
MIGRATION_MARKER_PATH=

# Bot owners automatically have every HearthBound permission in every supported ESO
# environment and configured Discord server. Private houses/tours stay owner-only.
# Use one Discord user ID, or multiple IDs separated by commas. No Discord roles
# are assigned. Example: BOT_OWNER_IDS=123456789012345678,234567890123456789
# Restart after changing this setting. Keep blank to leave owner access unconfigured.
BOT_OWNER_IDS=

# Legacy additional approvers: approval/revocation authority only, not owner access.
# Comma-separated Discord user IDs with bot-wide approval authority.
# The Global Housing Moderator grants they approve or revoke are environment-specific.
GLOBAL_MODERATOR_APPROVER_USER_IDS=

# true = clear configured guild-scoped commands, then publish globally.
# false = clear global commands, then publish only to DISCORD_GUILD_ID.
DEPLOY_GLOBAL=false

# Administration interface: "both" (default), "discord", or "web".
# In web mode, Housing Administration is hidden from /hearth and /housing; Discord
# administration interactions direct moderators to the companion web console.
ADMIN_INTERFACE=both

# Optional web administration. A Housing Moderator signs in with Discord.
# With direct Node.js, the listener binds to WEB_ADMIN_HOST. Docker Compose
# overrides that listener to 0.0.0.0 inside the container and publishes the
# port only to 127.0.0.1 on the Docker host.
WEB_ADMIN_ENABLED=false
# Member portal can be enabled independently of ADMIN_INTERFACE.
WEB_PORTAL_ENABLED=false
# Public HTTPS address for the Discord Open Web Portal link (include /app).
WEB_PORTAL_URL=
WEB_ADMIN_HOST=127.0.0.1
WEB_ADMIN_PORT=8787
# Signs login cookies, so use a long random value (at least 16 characters, 32 or more recommended):
#   openssl rand -base64 48
# Keep this secret stable across restarts so existing logins remain valid.
WEB_SESSION_SECRET=
# Persistent Discord login lifetime in days (1-365). Default: 30.
WEB_SESSION_DAYS=30
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=

# Per-user abuse protection for Share Pass actions and housing reports.
SHARE_PASS_RATE_LIMIT=5
SHARE_PASS_RATE_WINDOW_SECONDS=300
SHARE_PASS_ACCESS_RATE_LIMIT=60
SHARE_PASS_ACCESS_RATE_WINDOW_SECONDS=300
HOUSING_REPORT_RATE_LIMIT=5
HOUSING_REPORT_RATE_WINDOW_SECONDS=600

# Persistent screenshot storage shared by bot and web process.
# On Linux, prefer /var/lib/hearthbound/house-images (writable by the service user).
HOUSE_IMAGE_DIR=./data/house-images

# Optional tour artwork, persisted on the Linux host and shared by bot/web.
TOUR_COVER_DIR=./data/tour-covers
